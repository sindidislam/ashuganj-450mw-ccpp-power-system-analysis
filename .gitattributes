# ==============================================================================
# GitHub Linguist Language Configuration
# Ashuganj 450 MW CCPP Power System Analysis & Protection Studies
# ==============================================================================

# Mark all HTML manuals, presentation portals, and web assets as non-detectable documentation
# (ensures interactive HTML manuals do not dominate the repository language breakdown)
*.html linguist-documentation=true
*.html -linguist-detectable
*.htm linguist-documentation=true
*.htm -linguist-detectable
*.css linguist-documentation=true
*.css -linguist-detectable
*.js linguist-documentation=true
*.js -linguist-detectable

# Helper and build scripts marked as documentation
*.py linguist-documentation=true
*.py -linguist-detectable
*.ps1 linguist-documentation=true
*.ps1 -linguist-detectable

# Core programming language: MATLAB
*.m linguist-language=MATLAB
*.m linguist-detectable=true
Simulation_Workspace/matlab/** linguist-language=MATLAB
Simulation_Workspace/Phase6/** linguist-language=MATLAB
